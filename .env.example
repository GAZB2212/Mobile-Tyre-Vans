# ── Mobile Tyre Vans — deployment configuration ──────────────────────────────
# Copy to .env (or set in your host's environment) and fill in per deployment.

# Required
DATABASE_URL=postgres://user:password@host:5432/dbname
SESSION_SECRET=generate-a-long-random-string

# Public site URL (used for OAuth redirect URIs, email links, canonical URLs)
SITE_URL=https://www.example.co.uk

# Admin bootstrap (production refuses to start an admin account without these)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM="Your Brand <noreply@example.co.uk>"
# Fallback recipient for internal notifications when none are configured in
# Admin → Settings → Notification Recipients
ADMIN_NOTIFY_FALLBACK_EMAIL=

# Finance partner (also configurable in Admin → Settings)
FINANCE_COMPANY_EMAIL=

# Accounting integrations — configure the one(s) this deployment uses and
# pick the active provider in Admin → Settings → Accounting Integration.
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENVIRONMENT=sandbox

# Webhooks (shared secrets sent as the x-webhook-secret header)
WRAPGEN_WEBHOOK_SECRET=
AUTOTRADEOS_WEBHOOK_SECRET=

# Optional integrations
OPENAI_API_KEY=
CHECKCARDETAILS_API_KEY=

# Object storage (Replit object storage / GCS)
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
